# Flutter app public configuration.
# Copy this file to .env before running or building the app.
# Never put Supabase service-role/secret keys or Stellar secret seeds here.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Keep the app on Stellar Testnet during development.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
